{
  "name": "leetcode-reminder",
  "version": "1.0.0",
  "description": "LeetCode student reminder system with automated personalized voice calls (Twilio / Exotel) and browser announcements.",
  "main": "src/server.js",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
