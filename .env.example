# ---------------------------------------------------------------
# LeetCode Reminder - environment configuration
# Copy to .env and fill in ONLY the provider you actually have.
# Never commit .env. Secrets are never sent to the browser.
# ---------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development
# Public HTTPS URL where the provider can reach this server (needed for
# status callbacks / opt-out keypress in production). e.g. https://calls.example.com
PUBLIC_BASE_URL=
APP_TIMEZONE=Asia/Kolkata
MENTOR_NAME=your mentor

# Database (SQLite file). Format: sqlite:<path>
DATABASE_URL=sqlite:./data/leetcode-reminder.db

# Admin login. Use ADMIN_PASSWORD_HASH (generate with: npm run hash-password)
# or ADMIN_PASSWORD for local development only.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Long random string used to sign session cookies and callback tokens.
SESSION_SECRET=

# Calling provider: mock | twilio | exotel
# "mock" never places real calls - use it for development and testing.
CALL_PROVIDER=mock

# Twilio Programmable Voice (paid; caller ID must be a Twilio number or verified)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VOICE=Polly.Aditi
TWILIO_LANGUAGE=en-IN

# Exotel (paid; requires a KYC-verified ExoPhone and a call flow with a
# Greeting applet that reads dynamic text from this server - see README)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_APP_ID=

# Mock provider behaviour (development only):
# completed | no_answer | busy | failed | random
MOCK_CALL_OUTCOME=completed
